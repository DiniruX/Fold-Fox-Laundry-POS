# ═══════════════════════════════════════════════════════════════════
#  LAUNDRY POS SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and update with your actual values
# Command: cp env.example .env (Linux/Mac) or copy env.example .env (Windows)
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 🌍 ENVIRONMENT & SERVER
# ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ───────────────────────────────────────────────────────────────────
# 🗄️ DATABASE CONFIGURATION
# ───────────────────────────────────────────────────────────────────
# For local MongoDB: mongodb://localhost:27017/laundry_pos
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database

MONGO_URI=mongodb://localhost:27017/laundry_pos

# ───────────────────────────────────────────────────────────────────
# 🔐 JWT AUTHENTICATION
# ───────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# ───────────────────────────────────────────────────────────────────
# 🌐 FRONTEND CONFIGURATION
# ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────────
# 📧 EMAIL SERVICE CONFIGURATION (Nodemailer)
# ───────────────────────────────────────────────────────────────────
# For Gmail: Use App Password (Settings → Security → 2FA → App Passwords)
# See NOTIFICATION_SERVICE_SETUP.md for detailed setup instructions

EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-digit-app-password

# ───────────────────────────────────────────────────────────────────
# 📱 SMS SERVICE CONFIGURATION (Twilio)
# ───────────────────────────────────────────────────────────────────
# Get credentials from: https://console.twilio.com/
# Required for sending bank transfer details via SMS

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ───────────────────────────────────────────────────────────────────
# 💬 WHATSAPP INTEGRATION (Optional - Not Implemented)
# ───────────────────────────────────────────────────────────────────

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ───────────────────────────────────────────────────────────────────
# 🏢 BUSINESS INFORMATION
# ───────────────────────────────────────────────────────────────────
# Used in receipts, emails, and notifications

BUSINESS_NAME=Your Laundry Business Name
BUSINESS_ADDRESS=123 Main Street, City, State 12345
BUSINESS_PHONE=+94-11-1234567
BUSINESS_EMAIL=info@yourlaundry.com

# ───────────────────────────────────────────────────────────────────
# 🏦 BANK ACCOUNT DETAILS (For Payment Notifications)
# ───────────────────────────────────────────────────────────────────
# Update with your actual bank account information
# Sent to customers when they choose bank transfer payment

BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=Your Business Account Name
BANK_ACCOUNT_NUMBER=1234567890
BANK_BRANCH=Your Branch Name
BANK_SWIFT_CODE=BANKCODE

# ───────────────────────────────────────────────────────────────────
# 💰 CURRENCY & FINANCIAL SETTINGS
# ───────────────────────────────────────────────────────────────────

CURRENCY=LKR
TAX_RATE=0.00

# ───────────────────────────────────────────────────────────────────
# 🎓 LOYALTY & DISCOUNTS
# ───────────────────────────────────────────────────────────────────

STUDENT_DISCOUNT_PERCENTAGE=10
LOYALTY_POINTS_PER_RUPEE=1

# ───────────────────────────────────────────────────────────────────
# 📁 FILE UPLOAD CONFIGURATION
# ───────────────────────────────────────────────────────────────────

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ───────────────────────────────────────────────────────────────────
# 🛡️ SECURITY & RATE LIMITING
# ───────────────────────────────────────────────────────────────────

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ═══════════════════════════════════════════════════════════════════
# 📝 SETUP INSTRUCTIONS:
# ═══════════════════════════════════════════════════════════════════
# 
# 1. Copy this file to .env:
#    Windows: copy env.example .env
#    Linux/Mac: cp env.example .env
# 
# 2. Update all values marked with "your_" prefix
# 
# 3. Configure Email & SMS for notifications:
#    See NOTIFICATION_SERVICE_SETUP.md for detailed guide
# 
# 4. Test your configuration:
#    node test-notifications.js email your@email.com
#    node test-notifications.js sms +94771234567
# 
# 5. For production:
#    - Change NODE_ENV to "production"
#    - Use strong JWT_SECRET
#    - Use production database
#    - Configure proper CORS settings
# 
# DOCUMENTATION:
# - Setup Guide: NOTIFICATION_SERVICE_SETUP.md
# - Quick Start: QUICK_START_BANK_NOTIFICATIONS.md
# - Implementation: BANK_TRANSFER_NOTIFICATION_IMPLEMENTATION.md
# 
# ═══════════════════════════════════════════════════════════════════
