# ═══════════════════════════════════════════════════════════════════
#  LAUNDRY POS SYSTEM - FRONTEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and update with your actual values
# Command: cp env.example .env (Linux/Mac) or copy env.example .env (Windows)
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 🌐 API CONFIGURATION
# ───────────────────────────────────────────────────────────────────
# Backend API URL (must include /api at the end)

REACT_APP_API_URL=http://localhost:5000/api

# ───────────────────────────────────────────────────────────────────
# 🌍 ENVIRONMENT
# ───────────────────────────────────────────────────────────────────

NODE_ENV=development

# ───────────────────────────────────────────────────────────────────
# 📊 OPTIONAL INTEGRATIONS (Not Currently Used)
# ───────────────────────────────────────────────────────────────────

# Google Analytics
# REACT_APP_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking
# REACT_APP_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ═══════════════════════════════════════════════════════════════════
# 📝 SETUP INSTRUCTIONS:
# ═══════════════════════════════════════════════════════════════════
# 
# 1. Copy this file to .env:
#    Windows: copy env.example .env
#    Linux/Mac: cp env.example .env
# 
# 2. Update REACT_APP_API_URL to match your backend URL:
#    - Development: http://localhost:5000/api
#    - Production: https://your-domain.com/api
# 
# 3. Start the development server:
#    npm start
# 
# NOTES:
# - All React environment variables must start with REACT_APP_
# - Changes to .env require restarting the development server
# - Never commit .env to version control
# 
# ═══════════════════════════════════════════════════════════════════
